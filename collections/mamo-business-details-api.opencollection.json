{
  "opencollection": "1.0.0",
  "info": {
    "name": "Mamo Business Business Details API",
    "version": "1.6"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Business Details",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Fetch Account Balances",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://business.mamopay.com/manage_api/v1/finances",
            "headers": [
              {
                "name": "Content-Type",
                "value": "application/json"
              },
              {
                "name": "Authorization",
                "value": "Bearer <your sandbox api key>"
              }
            ]
          },
          "docs": "API to fetch the balances of the merchant's different Mamo accounts.<br><br>"
        },
        {
          "info": {
            "name": "Fetch Business Info",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://business.mamopay.com/manage_api/v1/me",
            "headers": [
              {
                "name": "Content-Type",
                "value": "application/json"
              },
              {
                "name": "Authorization",
                "value": "Bearer <your sandbox api key>"
              }
            ]
          },
          "docs": "API to fetch your business info.<br><br>"
        }
      ]
    }
  ],
  "bundled": true
}