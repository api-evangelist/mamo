{
  "opencollection": "1.0.0",
  "info": {
    "name": "Mamo Business Business Details Expenses API",
    "version": "1.6"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Expenses",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Update Expense",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://business.mamopay.com/manage_api/v1/expenses/:expenseId",
            "headers": [
              {
                "name": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "name": "Authorization",
                "value": "Bearer <your sandbox api key>"
              }
            ],
            "params": [
              {
                "name": "expenseId",
                "value": "EXP-F096A17391",
                "type": "path",
                "description": "Expense ID"
              }
            ],
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "invoice_number",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "description",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "status",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Updates expense details such as description, invoice number, and status"
        }
      ]
    }
  ],
  "bundled": true
}